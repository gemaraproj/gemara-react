---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { parse as parseYaml } from "yaml";
import { ControlCatalog } from "@gemara/react/control-catalog";
import { GuidanceCatalog } from "@gemara/react/guidance-catalog";
import { GemaraProvider } from "@gemara/react/provider";
import { detectArtifactType, isControlCatalog, isGuidanceCatalog } from "@gemara/react";
import CollapsibleControlGroup from "../components/CollapsibleControlGroup.tsx";
import CollapsibleGuidanceGroup from "../components/CollapsibleGuidanceGroup.tsx";
import MultiFormatViewer from "../components/MultiFormatViewer.tsx";
// The OSCAL projection is produced server-side by go-gemara, never in the
// browser. Pre-generated with:
//   (cd ../../../go-gemara && go run ./cmd/oscalexport catalog \
//      ../gemara/test/test-data/good-ccc.yaml --output catalog.json)
// then committed as a fixture. `?raw` hands us the file as an opaque string —
// exactly what a `fetch()` against the hub API would give you.
import oscal from "../fixtures/good-ccc.oscal.json?raw";
// The Markdown projection comes from go-gemara's `ControlCatalog(c).ToMarkdown`.
// (gemaraconv has no CLI for it, so the fixture was generated with a one-off
// program and committed.) Same `?raw` import — an opaque string we display.
import markdown from "../fixtures/good-ccc.md?raw";
// GuidanceCatalog exports as an OSCAL Catalog + Profile pair:
//   go run ./cmd/oscalexport guidance ../gemara/test/test-data/good-aigf.yaml \
//      -catalog-output good-aigf.oscal.json -profile-output good-aigf.oscal-profile.json
// There is no Markdown projection for guidance in gemaraconv yet.
import aigfOscal from "../fixtures/good-aigf.oscal.json?raw";
import aigfProfile from "../fixtures/good-aigf.oscal-profile.json?raw";

// Load fixtures from the canonical gemara repo at build time. In a real app
// these would come from the hub API or a content collection.
// Resolve from the build's working directory (examples/astro), not
// import.meta.url, which points at a bundled chunk whose depth varies by Astro version.
const fixtureDir = resolve(process.cwd(), "..", "..", "..", "gemara", "test", "test-data");

function loadFixture(name: string) {
  const raw = readFileSync(resolve(fixtureDir, name), "utf8");
  const parsed: unknown = parseYaml(raw);
  const type = detectArtifactType(parsed);
  if (!type) throw new Error("Unrecognized artifact type in " + name);
  return { name, raw, parsed, type };
}

const ccc = loadFixture("good-ccc.yaml");
if (!isControlCatalog(ccc.parsed)) {
  throw new Error("Expected ControlCatalog at " + ccc.name);
}
const data = ccc.parsed;
const firstGroupId = data.groups?.[0]?.id ?? "";

const aigf = loadFixture("good-aigf.yaml");
if (!isGuidanceCatalog(aigf.parsed)) {
  throw new Error("Expected GuidanceCatalog at " + aigf.name);
}
const guidance = aigf.parsed;
const firstGuidanceGroupId = guidance.groups?.[0]?.id ?? "";

// One fixture per remaining artifact type: Preview + raw YAML for each.
const others = [
  "good-aigf-principles.yaml",
  "good-aigf-vectors.yaml",
  "good-risk-catalog.yaml",
  "good-threat-catalog.yaml",
  "good-capability-catalog.yaml",
  "good-policy.yaml",
  "good-lexicon.yaml",
  "good-mapping-document.yaml",
  "good-audit-log.yaml",
  "good-enforcement-log.yaml",
  "pvtr-baseline-scan.yaml",
].map(loadFixture);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>gemara-react Astro example</title>
    <style is:global>
      :root {
        --demo-bg: #ffffff;
        --demo-panel: #f4f6f8;
        --demo-border: #c8d0d8;
        --demo-text: #17212b;
        --demo-muted: #526170;
        --demo-accent: #45208c;
      }

      [data-theme="dark"] {
        --demo-bg: #17191f;
        --demo-panel: #242832;
        --demo-border: #46505d;
        --demo-text: #f0f3f6;
        --demo-muted: #b7c1cc;
        --demo-accent: #b9a2ff;
      }

      * { box-sizing: border-box; }
      html { background: var(--demo-bg); }
      body {
        max-width: 72rem;
        margin: 0 auto;
        padding: 1rem;
        background: var(--demo-bg);
        color: var(--demo-text);
        font: 1rem/1.5 system-ui, sans-serif;
      }

      a { color: var(--demo-accent); }
      hr { margin: 2rem 0; border: 0; border-top: 1px solid var(--demo-border); }
      [data-gemara-artifact], [data-gemara-part] { color: var(--demo-text); }
      [data-gemara-part="format-tabs"] {
        overflow: hidden;
        border: 1px solid var(--demo-border);
        border-radius: 6px;
        background: var(--demo-bg);
      }
      [data-gemara-part="format-tablist"] {
        display: flex;
        gap: .25rem;
        padding: .5rem .75rem 0;
        background: var(--demo-panel);
        border-bottom: 1px solid var(--demo-border);
      }
      [data-gemara-part="format-tab"] {
        padding: .5rem .75rem;
        border: 0;
        background: transparent;
        color: var(--demo-muted);
        cursor: pointer;
      }
      [data-gemara-part="format-tab"][aria-selected="true"] {
        background: var(--demo-bg);
        color: var(--demo-accent);
        font-weight: 700;
      }
      [data-gemara-part="format-panel"] { padding: 1rem; }
      [data-gemara-part="format-code"] {
        overflow: auto;
        padding: 1rem;
        background: var(--demo-panel);
        color: var(--demo-text);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>gemara-react: ControlCatalog (server-rendered)</h1>
      <GemaraProvider>
        <ControlCatalog data={data} headingLevel={2} />
      </GemaraProvider>

      <hr />

      <h2>Interactive island (client:idle)</h2>
      {firstGroupId && (
        <CollapsibleControlGroup
          client:idle
          data={data}
          groupId={firstGroupId}
        />
      )}

      <hr />

      <h2>Multi-format viewer (client:idle)</h2>
      <p>
        Preview (rendered from the structured data) + raw YAML, Markdown, and
        OSCAL. The Markdown and OSCAL are pre-converted by go-gemara and passed in
        as strings; the component does no conversion or validation.
      </p>
      <MultiFormatViewer
        client:idle
        type={ccc.type}
        data={data}
        yaml={ccc.raw}
        markdown={markdown}
        oscal={oscal}
      />

      <hr />

      <h1>gemara-react: GuidanceCatalog (server-rendered)</h1>
      <GemaraProvider>
        <GuidanceCatalog data={guidance} headingLevel={2} />
      </GemaraProvider>

      <hr />

      <h2>Interactive island (client:idle)</h2>
      {firstGuidanceGroupId && (
        <CollapsibleGuidanceGroup
          client:idle
          data={guidance}
          groupId={firstGuidanceGroupId}
        />
      )}

      <hr />

      <h2>Multi-format viewer (client:idle)</h2>
      <p>
        Preview + raw YAML + OSCAL Catalog and Profile (the pair
        <code>oscalexport guidance</code> emits). No Markdown tab: gemaraconv has
        no guidance Markdown projection yet.
      </p>
      <MultiFormatViewer
        client:idle
        type={aigf.type}
        data={guidance}
        yaml={aigf.raw}
        oscal={aigfOscal}
        oscalProfile={aigfProfile}
      />

      <hr />

      <h2>All other artifact types: Preview + raw YAML (client:idle)</h2>
      {others.map((f) => (
        <section>
          <h3>{f.type} <small>({f.name})</small></h3>
          <MultiFormatViewer client:idle type={f.type} data={f.parsed} yaml={f.raw} />
        </section>
      ))}
    </main>
    <script>
      const allowedThemes = new Set(["dark", "light"]);

      function sendReady() {
        window.parent.postMessage({ type: "gemara-ready" }, "*");
      }

      function sendHeight() {
        window.parent.postMessage(
          { type: "gemara-resize", height: document.documentElement.scrollHeight },
          "*",
        );
      }

      window.addEventListener("message", (event) => {
        if (event.data?.type === "gemara-theme" && allowedThemes.has(event.data.theme)) {
          document.documentElement.dataset.theme = event.data.theme;
          sendHeight();
        }
      });

      window.addEventListener("load", () => {
        sendReady();
        sendHeight();
      });

      new ResizeObserver(sendHeight).observe(document.body);
    </script>
  </body>
</html>
